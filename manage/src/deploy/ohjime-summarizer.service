# ohjime Telegram-message summarizer (one-shot) — installed by deploy/install.sh
#
# Run manually with:  sudo systemctl start ohjime-summarizer
# Follow output with: journalctl -u ohjime-summarizer -f

[Unit]
Description=Process collected ohjime Telegram messages
# The model server must be up; if it is not, this run simply fails and the
# timer retries on the next tick.
After=ohjime-vllm.service network-online.target
Wants=ohjime-vllm.service

[Service]
Type=oneshot
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@SRC_DIR@@
Environment="HOME=@@HOME@@"
Environment="PATH=@@HOME@@/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/etc/ohjime/telegram.env

# After= orders service startup but a Type=simple vLLM unit can still be loading
# weights. This helper reads the same project .env endpoint, key, and model as
# the ADK client, so custom ports and authenticated endpoints stay consistent.
ExecStartPre="@@SRC_DIR@@/.venv/bin/python" "@@SRC_DIR@@/wait_for_vllm.py" --timeout 600
ExecStart="@@SRC_DIR@@/.venv/bin/python" "@@SRC_DIR@@/summarize.py"

# Allow a missed-day backlog to drain through several context-sized batches.
# Every completed batch is durable if this outer safety limit is ever reached.
TimeoutStartSec=6h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
