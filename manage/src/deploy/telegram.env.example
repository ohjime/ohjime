# ohjime Telegram collector and daily processor configuration.
# Installed to /etc/ohjime/telegram.env with root-only permissions. From the
# repository root, run `make telegram-env` to fill the first three values, then
# `make run` to enable collection and the 10:00 PM timer.

TELEGRAM_BOT_TOKEN=replace_with_real_token
ALLOWED_USER_ID=replace_with_numeric_user_id
ALLOWED_CHAT_ID=replace_with_numeric_chat_id

DB_PATH=/var/lib/ohjime/messages.db
LOCAL_TIMEZONE=America/Edmonton
MAX_BATCH_BYTES=12000

# Optional private-chat topic IDs. Prefixes such as `t:` and `a:` work without
# these values.
# THOUGHT_THREAD_ID=12
# ACTION_THREAD_ID=18
